# Server Port (Default: 3001)
PORT=3001

# Master Encryption Key (32 bytes / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Public Production Base URL (e.g. https://ephemeral-vault.onrender.com or https://vault.yourdomain.com)
# If left blank, the app dynamically detects host & protocol (HTTP/HTTPS) from incoming requests.
PUBLIC_BASE_URL=

# SQLite Database Storage Location (Default: ./vault.sqlite)
# For persistent deployment, set to your volume mount path, e.g. /data/vault.sqlite
DB_PATH=
